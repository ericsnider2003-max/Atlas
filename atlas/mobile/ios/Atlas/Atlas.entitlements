<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app and its share extension hand shared items over through
	     this group's folder (Shared/SharedInbox.swift). -->
	<key>com.apple.security.application-groups</key>
	<array><string>group.group.com.ericsnider.atlas</string></array>
	<!-- Apple's push service, so the laptop's Atlas can reach this phone with
	     the app closed (item 15). Ad hoc builds use the production service. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Apple's weather for Atlas's weather answers (AppleWeather.swift). -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
