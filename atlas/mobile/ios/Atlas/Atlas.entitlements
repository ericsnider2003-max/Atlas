<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app and its share extension hand shared items over through
	     this group's folder (Shared/SharedInbox.swift). -->
	<key>com.apple.security.application-groups</key>
	<array><string>group.group.com.ericsnider.atlas</string></array>
</dict>
</plist>
