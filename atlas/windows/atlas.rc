// Atlas.exe's icon, and the name Windows shows for it (Task Manager, its
// security prompts). design/mark/make_marks.py writes this and the two
// compiled forms beside it; build.rs links the right one.
1 ICON "../assets/atlas.ico"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Atlas"
      VALUE "ProductName", "Atlas"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "atlas.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
